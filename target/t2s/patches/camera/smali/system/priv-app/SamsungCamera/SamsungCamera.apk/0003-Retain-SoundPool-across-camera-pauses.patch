Date: Mon, 24 Aug 2026 21:05:00 +0200
Subject: [PATCH] camera: retain SoundPool across activity pauses

Camera's inactivity close releases SoundPool while its AudioTrack callback can
still be queued in another Binder thread. On the target this races the Binder
thread-pool shutdown and leaves a pending strong dereference with a destroyed
AudioTrackCallback object, crashing joinThreadPool with a null vtable.

Keep the process-scoped SoundPool alive across Camera pause/resume cycles. The
executor is still shut down and awaited on pause, then recreated on resume;
Android releases the SoundPool with the process. This avoids the native
AudioTrack/Binder use-after-free without leaving Camera worker tasks running.
---
 .../sec/android/app/camera/audio/SoundManager.smali | 32 ---------------------
 1 file changed, 32 deletions(-)

diff --git a/smali_classes3/com/sec/android/app/camera/audio/SoundManager.smali b/smali_classes3/com/sec/android/app/camera/audio/SoundManager.smali
--- a/smali_classes3/com/sec/android/app/camera/audio/SoundManager.smali
+++ b/smali_classes3/com/sec/android/app/camera/audio/SoundManager.smali
@@ -692,37 +692,5 @@
 
     invoke-static {v1, v3}, Landroid/util/Log;->d(Ljava/lang/String;Ljava/lang/String;)I
 
-    iget-object v1, p0, Lcom/sec/android/app/camera/audio/SoundManager;->mSoundPool:Landroid/media/SoundPool;
-
-    if-eqz v1, :cond_5
-
-    invoke-virtual {v1}, Landroid/media/SoundPool;->release()V
-
-    iput-object v2, p0, Lcom/sec/android/app/camera/audio/SoundManager;->mSoundPool:Landroid/media/SoundPool;
-
-    move v1, v0
-
-    :goto_4
-    invoke-static {}, Lcom/sec/android/app/camera/interfaces/CameraAudioManager$SoundId;->values()[Lcom/sec/android/app/camera/interfaces/CameraAudioManager$SoundId;
-
-    move-result-object v2
-
-    array-length v2, v2
-
-    if-ge v1, v2, :cond_5
-
-    iget-object v2, p0, Lcom/sec/android/app/camera/audio/SoundManager;->mSoundPoolId:[I
-
-    aput v0, v2, v1
-
-    iget-object v2, p0, Lcom/sec/android/app/camera/audio/SoundManager;->mStreamId:[I
-
-    aput v0, v2, v1
-
-    add-int/lit8 v1, v1, 0x1
-
-    goto :goto_4
-
-    :cond_5
     return-void
 .end method
