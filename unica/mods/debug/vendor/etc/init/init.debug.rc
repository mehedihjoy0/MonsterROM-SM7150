on post-fs
    rm /cache/logcat.txt

# Persistent all-buffer recording is expensive and can fill /cache. Keep it
# available for explicit diagnostics, with a hard 10 MiB retention ceiling.
on property:persist.unica.logcat_cache=1
    start logcat_cache

on property:persist.unica.logcat_cache=0
    stop logcat_cache

service logcat_cache /system/bin/logcat -b all -f /cache/logcat.txt -r 2048 -n 4 -v threadtime
    class main
    user root
    group system
    seclabel u:r:su:s0
    disabled
