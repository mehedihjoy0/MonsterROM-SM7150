From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: devcore94 <ditternation@outlook.com>
Date: Fri, 5 Jun 2026 20:20:00 +0200
Subject: [PATCH] Adapt MemoryIntArray native ABI

---
diff --git a/smali_classes4/android/util/MemoryIntArray.smali b/smali_classes4/android/util/MemoryIntArray.smali
index 8f3076f8..3924d96a 100644
--- a/smali_classes4/android/util/MemoryIntArray.smali
+++ b/smali_classes4/android/util/MemoryIntArray.smali
@@ -98,7 +98,7 @@
 
     iget v2, p0, Landroid/util/MemoryIntArray;->mFd:I
 
-    invoke-direct {p0, v2, v1, p1}, Landroid/util/MemoryIntArray;->nativeOpen(IZI)J
+    invoke-direct {p0, v2, v1}, Landroid/util/MemoryIntArray;->nativeOpen(IZ)J
 
     move-result-wide v1
 
@@ -170,7 +170,7 @@
 
     iget v2, p0, Landroid/util/MemoryIntArray;->mFd:I
 
-    invoke-direct {p0, v2, v1, p1}, Landroid/util/MemoryIntArray;->nativeOpen(IZI)J
+    invoke-direct {p0, v2, v1}, Landroid/util/MemoryIntArray;->nativeOpen(IZ)J
 
     move-result-wide v1
 
@@ -287,21 +287,21 @@
     return v0
 .end method
 
-.method private native blacklist nativeClose(IJI)V
+.method private native blacklist nativeClose(IJZ)V
 .end method
 
 .method private native greylist-max-o nativeCreate(Ljava/lang/String;I)I
 .end method
 
-.method private native blacklist nativeGet(JI)I
+.method private native blacklist nativeGet(IJI)I
     .annotation build Ldalvik/annotation/optimization/FastNative;
     .end annotation
 .end method
 
-.method private native blacklist nativeOpen(IZI)J
+.method private native blacklist nativeOpen(IZ)J
 .end method
 
-.method private native blacklist nativeSet(JII)V
+.method private native blacklist nativeSet(IJII)V
     .annotation build Ldalvik/annotation/optimization/FastNative;
     .end annotation
 .end method
@@ -329,9 +329,9 @@
 
     iget-wide v1, p0, Landroid/util/MemoryIntArray;->mMemoryAddr:J
 
-    iget v3, p0, Landroid/util/MemoryIntArray;->mSize:I
+    iget-boolean v3, p0, Landroid/util/MemoryIntArray;->mIsOwner:Z
 
-    invoke-direct {p0, v0, v1, v2, v3}, Landroid/util/MemoryIntArray;->nativeClose(IJI)V
+    invoke-direct {p0, v0, v1, v2, v3}, Landroid/util/MemoryIntArray;->nativeClose(IJZ)V
 
     const/4 v0, -0x1
 
@@ -430,7 +430,7 @@
 .end method
 
 .method public greylist-max-o get(I)I
-    .locals 2
+    .locals 3
     .annotation system Ldalvik/annotation/Throws;
         value = {
             Ljava/io/IOException;
@@ -443,7 +443,9 @@
 
     iget-wide v0, p0, Landroid/util/MemoryIntArray;->mMemoryAddr:J
 
-    invoke-direct {p0, v0, v1, p1}, Landroid/util/MemoryIntArray;->nativeGet(JI)I
+    iget v2, p0, Landroid/util/MemoryIntArray;->mFd:I
+
+    invoke-direct {p0, v2, v0, v1, p1}, Landroid/util/MemoryIntArray;->nativeGet(IJI)I
 
     move-result p0
 
@@ -488,7 +490,7 @@
 .end method
 
 .method public greylist-max-o set(II)V
-    .locals 2
+    .locals 6
     .annotation system Ldalvik/annotation/Throws;
         value = {
             Ljava/io/IOException;
@@ -501,9 +503,17 @@
 
     invoke-direct {p0, p1}, Landroid/util/MemoryIntArray;->enforceValidIndex(I)V
 
-    iget-wide v0, p0, Landroid/util/MemoryIntArray;->mMemoryAddr:J
+    iget-wide v2, p0, Landroid/util/MemoryIntArray;->mMemoryAddr:J
+
+    iget v1, p0, Landroid/util/MemoryIntArray;->mFd:I
+
+    move-object v0, p0
+
+    move v4, p1
+
+    move v5, p2
 
-    invoke-direct {p0, v0, v1, p1, p2}, Landroid/util/MemoryIntArray;->nativeSet(JII)V
+    invoke-direct/range {v0 .. v5}, Landroid/util/MemoryIntArray;->nativeSet(IJII)V
 
     return-void
 .end method
