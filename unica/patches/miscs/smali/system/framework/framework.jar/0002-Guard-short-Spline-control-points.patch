From 6bc5c4a9608283de9f1704cd3fe91fd4f0ffbbf4 Mon Sep 17 00:00:00 2001
From: Salvo Giangreco <giangrecosalvo9@gmail.com>
Date: Mon, 1 Jun 2026 16:22:00 +0200
Subject: [PATCH] Guard short Spline control points

One UI 8.5 display boot can feed android.util.Spline a zero/one point
brightness curve on legacy target overlays. That throws in the display
thread during system_server startup and loops recovery. Fall back to a
constant two-point linear spline so display policy can continue booting.
---
 smali_classes4/android/util/Spline.smali | 81 +++++++++++++++++++++---
 1 file changed, 68 insertions(+), 13 deletions(-)

diff --git a/smali_classes4/android/util/Spline.smali b/smali_classes4/android/util/Spline.smali
index 5f847a1..21b4080 100644
--- a/smali_classes4/android/util/Spline.smali
+++ b/smali_classes4/android/util/Spline.smali
@@ -42,41 +42,96 @@
 .end method
 
 .method public static greylist-max-o createSpline([F[F)Landroid/util/Spline;
-    .locals 1
+    .locals 5
+
+    const/4 v0, 0x0
+
+    const/4 v1, 0x2
+
+    const/4 v2, 0x1
+
+    if-eqz p0, :fallback
+
+    if-eqz p1, :fallback
+
+    array-length v3, p0
+
+    array-length v4, p1
+
+    if-ne v3, v4, :fallback
+
+    if-lt v3, v1, :fallback
 
     invoke-static {p0}, Landroid/util/Spline;->isStrictlyIncreasing([F)Z
 
-    move-result v0
+    move-result v3
 
-    if-eqz v0, :cond_1
+    if-eqz v3, :cond_1
 
     invoke-static {p1}, Landroid/util/Spline;->isMonotonic([F)Z
 
-    move-result v0
+    move-result v3
 
-    if-eqz v0, :cond_0
+    if-eqz v3, :cond_0
 
     invoke-static {p0, p1}, Landroid/util/Spline;->createMonotoneCubicSpline([F[F)Landroid/util/Spline;
 
-    move-result-object p0
+    move-result-object v0
 
-    return-object p0
+    return-object v0
 
     :cond_0
     invoke-static {p0, p1}, Landroid/util/Spline;->createLinearSpline([F[F)Landroid/util/Spline;
 
-    move-result-object p0
+    move-result-object v0
 
-    return-object p0
+    return-object v0
 
     :cond_1
-    new-instance p0, Ljava/lang/IllegalArgumentException;
+    new-instance v0, Ljava/lang/IllegalArgumentException;
 
-    const-string p1, "The control points must all have strictly increasing X values."
+    const-string v1, "The control points must all have strictly increasing X values."
 
-    invoke-direct {p0, p1}, Ljava/lang/IllegalArgumentException;-><init>(Ljava/lang/String;)V
+    invoke-direct {v0, v1}, Ljava/lang/IllegalArgumentException;-><init>(Ljava/lang/String;)V
+
+    throw v0
+
+    :fallback
+    if-eqz p1, :fallback_zero
+
+    array-length v3, p1
+
+    if-lez v3, :fallback_zero
+
+    aget v3, p1, v0
+
+    goto :fallback_value
+
+    :fallback_zero
+    const/4 v3, 0x0
+
+    :fallback_value
+    new-array p0, v1, [F
+
+    new-array p1, v1, [F
+
+    const/4 v4, 0x0
+
+    aput v4, p0, v0
+
+    const/high16 v4, 0x3f800000    # 1.0f
+
+    aput v4, p0, v2
+
+    aput v3, p1, v0
+
+    aput v3, p1, v2
+
+    invoke-static {p0, p1}, Landroid/util/Spline;->createLinearSpline([F[F)Landroid/util/Spline;
+
+    move-result-object v0
 
-    throw p0
+    return-object v0
 .end method
 
 .method private static greylist-max-o isMonotonic([F)Z
-- 
