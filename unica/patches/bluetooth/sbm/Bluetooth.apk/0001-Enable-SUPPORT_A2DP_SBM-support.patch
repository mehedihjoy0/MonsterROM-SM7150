     iget-object p3, p0, Lcom/android/bluetooth/btservice/ProfileService;->mAdapterService:Lcom/android/bluetooth/btservice/AdapterService;

+    const/4 v1, 0x1
+
     invoke-direct {p1, v1, p2, p3}, Lcom/android/bluetooth/a2dp/A2dpSbmManager;-><init>(ZLandroid/media/AudioManager;Lcom/android/bluetooth/btservice/AdapterService;)V

     iput-object p1, p0, Lcom/android/bluetooth/a2dp/A2dpService;->mA2dpSbmManager:Lcom/android/bluetooth/a2dp/A2dpSbmManager;
