From: devcore94 <ditternation@outlook.com>
Subject: [PATCH] kernelsu: expose appended init rc size for KSU Next

Android 17 init sizes init.rc with fstat before reading it. The manual-hook
fstat return hooks were accidentally compiled only for CONFIG_KSU_SUKI,
even though CONFIG_KSU_NEXT provides the same handlers. As a result init
never reads the appended KernelSU actions and ksud post-fs-data does not
run.

Enable the size-adjustment hooks for both supported KernelSU flavors.

diff --git a/fs/stat.c b/fs/stat.c
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -392,6 +392,6 @@ extern int ksu_handle_stat(int *dfd, const char __user **filename_user, int *fl
 #endif
 
-#if defined(CONFIG_KSU_MANUAL_HOOK) && defined(CONFIG_KSU_SUKI)
+#if defined(CONFIG_KSU_MANUAL_HOOK) && (defined(CONFIG_KSU_SUKI) || defined(CONFIG_KSU_NEXT))
 extern void ksu_handle_newfstat_ret(unsigned int *fd,
 				    struct stat __user **statbuf_ptr);
 #if defined(__ARCH_WANT_STAT64) || defined(__ARCH_WANT_COMPAT_STAT64)
@@ -426,7 +426,7 @@ SYSCALL_DEFINE2(newfstat, unsigned int, fd, struct stat __user *, statbuf)
 
 	if (!error)
 		error = cp_new_stat(&stat, statbuf);
-#if defined(CONFIG_KSU_MANUAL_HOOK) && defined(CONFIG_KSU_SUKI)
+#if defined(CONFIG_KSU_MANUAL_HOOK) && (defined(CONFIG_KSU_SUKI) || defined(CONFIG_KSU_NEXT))
 	if (!error)
 		ksu_handle_newfstat_ret(&fd, &statbuf);
 #endif
@@ -557,7 +557,7 @@ SYSCALL_DEFINE2(fstat64, unsigned long, fd, struct stat64 __user *, statbuf)
 
 	if (!error)
 		error = cp_new_stat64(&stat, statbuf);
-#if defined(CONFIG_KSU_MANUAL_HOOK) && defined(CONFIG_KSU_SUKI)
+#if defined(CONFIG_KSU_MANUAL_HOOK) && (defined(CONFIG_KSU_SUKI) || defined(CONFIG_KSU_NEXT))
 	if (!error)
 		ksu_handle_fstat64_ret(&fd, &statbuf);
 #endif
